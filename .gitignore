# Dependencies, package caches, and generated builds
node_modules/
.pnpm-store/
.vite/
.cache/
dist/
dist-ssr/
*.tsbuildinfo

# Test reports and diagnostic output
coverage/
.nyc_output/
playwright-report/
test-results/
logs/
*.log
*.log.*

# Private research inputs and generated local archives/QA.
# Only reviewed crosswalk sources belong in the root data directory in Git.
# public/data/ remains versioned because the frontend requires those files.
/data/*
!/data/crosswalks/
/.tools/

# Protect large GIS exports even if accidentally saved outside data/.
*.mbtiles
*.pmtiles
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.tif
*.tiff
*.vrt
*.qgz

# Local environment, provider state, and private workspace configuration
.env
.env.*
!.env.example
*.local
.dev.vars
.dev.vars.*
.vercel/
.wrangler/
/.aws/
/.codex/
/.agents/

# Personal editor settings; share the useful Vue extension recommendation.
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata and temporary/backup files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
