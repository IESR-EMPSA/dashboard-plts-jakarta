# Public URL only; never put R2/Vercel tokens or storage credentials here.
# Leave empty to use the fixed local PMTiles Range endpoint during pnpm dev.
# Production/preview building footprints require a verified public Range/CORS URL.
# See docs/R2_LOCAL_INTEGRATION.md for the tested R2 URL and local fallback.
# Restart Vite after changing the value; no automatic remote-to-local failover.
VITE_BUILDINGS_PMTILES_URL=
